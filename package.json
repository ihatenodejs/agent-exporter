{
  "name": "agent-exporter",
  "version": "1.0.4",
  "description": "Export usage statistics from various harnesses",
  "type": "module",
  "bin": {
    "agent-exporter": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__",
    "!src/**/__fixtures__/**",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --compile --minify --outfile dist/agent-exporter",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "link": "bun link",
    "start": "./dist/agent-exporter",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pre-commit run --all-files && bun run typecheck && bun run test",
    "package:smoke": "bun run scripts/package-smoke.ts"
  },
  "keywords": [
    "ai",
    "usage",
    "tracking",
    "opencode",
    "ccusage",
    "claude-code",
    "codex",
    "statistics",
    "claude",
    "anthropic",
    "openai",
    "antigravity",
    "oh-my-pi"
  ],
  "author": "ihatenodejs",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihatenodejs/agent-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/ihatenodejs/agent-exporter/issues"
  },
  "homepage": "https://github.com/ihatenodejs/agent-exporter#readme",
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@oh-my-pi/pi-catalog": "18.12.1",
    "@pydantic/genai-prices": "^0.1.13",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react-devtools-core": "^8.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
