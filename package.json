{
  "name": "agent-exporter",
  "version": "1.0.3",
  "description": "Export usage statistics from various agents",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "agent-exporter": "scripts/bin.cjs"
  },
  "files": [
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run generate-version && bun run build:all && node scripts/postinstall.cjs",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64",
    "build:linux-x64": "bun build src/cli.ts --compile --minify --target=bun-linux-x64 --outfile dist/agent-exporter-linux-x64",
    "build:linux-arm64": "bun build src/cli.ts --compile --minify --target=bun-linux-arm64 --outfile dist/agent-exporter-linux-arm64",
    "build:darwin-x64": "bun build src/cli.ts --compile --minify --target=bun-darwin-x64 --outfile dist/agent-exporter-darwin-x64",
    "build:darwin-arm64": "bun build src/cli.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/agent-exporter-darwin-arm64",
    "generate-version": "bun scripts/generate-version.ts",
    "dev": "bun run generate-version && bun run src/cli.ts",
    "test": "bun test",
    "link": "bun link",
    "start": "bun dist/agent-exporter",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sync-versions": "node scripts/sync-versions.cjs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "keywords": [
    "ai",
    "usage",
    "tracking",
    "opencode",
    "ccusage",
    "claude-code",
    "codex",
    "export",
    "claude",
    "anthropic",
    "openai",
    "gemini",
    "qwen code"
  ],
  "author": "ihatenodejs",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihatenodejs/agent-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/ihatenodejs/agent-exporter/issues"
  },
  "homepage": "https://github.com/ihatenodejs/agent-exporter#readme",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@pydantic/genai-prices": "^0.0.47",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dayjs": "^1.11.19",
    "ink": "^6.5.1",
    "react": "^19.2.0",
    "zod": "^4.1.13"
  },
  "optionalDependencies": {
    "@agent-exporter/linux-x64": "1.0.3",
    "@agent-exporter/linux-arm64": "1.0.3",
    "@agent-exporter/darwin-x64": "1.0.3",
    "@agent-exporter/darwin-arm64": "1.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "react-devtools-core": "^7.0.1",
    "prettier": "^3.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
